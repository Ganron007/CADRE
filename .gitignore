# ───────────────────────── Nested sister-product pins (never CADRE parent) ──
# These trees are synced locally from their own git (RedStrike, DFIR-Nexus).
# CADRE parent must not track or push them — that would publish the same
# product twice. Commit inside each pin's .git only.
# CADRE-owned helpers (tools/*.sh, regen-config, vm-access.md, …) stay tracked.
tools/dfir-nexus/
tools/red-strike/

# ───────────────────────── Internal / never-publish ─────────────────────────
docs/internal/
AGENTS.md
CHECKLIST.md   # master tracker — lives at docs/internal/CHECKLIST.md (local only)
CLAUDE.md   # auto-generated by gitnexus/graphify — local agent context, never shipped

# Campaign — archived monoliths, live validation ledgers, evidence captures (keep locally)
attack-matrix/Campaign/archive/
attack-matrix/Campaign/artifacts/
attack-matrix/Campaign/CAMPAIGNS-VALIDATION-REPORT.md
attack-matrix/Campaign/REDSTRIKE-VALIDATION-REPORT.md
attack-matrix/Campaign/CADRE-Attack-Surface-Coverage-Audit.md
attack-matrix/Campaign/automation/lab-seed-creds.json
attack-matrix/Campaign/automation/SCRIPTED-VS-REDSTRIKE-MAPPING.md
attack-matrix/Campaign/automation/patch-validation-report.py

# Lab wordlists / RedStrike seed ledger (committed templates: *.example.*)
ansible/files/cadre_passwords.txt

# Maintainer operator notes + Plan 1 batch harness (not public surface)
tools/vm-access.md
tools/plan1-*
tools/es-*
tools/build_campaign_validation_report.py
tools/dfir-full-live.ps1
tools/dfir-full-ready-check.py
tools/dfir-spine-*
tools/_tmp_check_zeek.py

# ───────────────────────── Code-intelligence / graph tools ──────────────────
.gitnexus/
graphify-out/

# ───────────────────────── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
.env/
.venv/
*.egg-info/

# ───────────────────────── Vagrant / VM state ───────────────────────────────
.vagrant/
*.box
# VMware VM dirs created under the provider dir by a stray `vagrant up`
lab/providers/vmware/*/

# ───────────────────────── Large vendor installers (NEVER commit — >100 MB) ──
# Kept on disk + on the provisioning VM; fetched separately. GitHub rejects >100 MB.
ansible/files/executables/*
!ansible/files/executables/.gitkeep
# Legacy archived-role media paths
ansible/roles/sccm/files/ConfigMgr_2509.exe
ansible/roles/sccm/files/SQL2022-Express-x64-ENU.exe
ansible/roles/cloud/files/AADConnectProvisioningAgentSetup.exe

# ───────────────────────── Secrets / certs ──────────────────────────────────
*.pfx
*.p12
*.retry
.env

# ───────────────────────── Agent / editor tooling (local, not shipped) ──────
.claude/
.cursor/
.opencode/
.agents/

# ───────────────────────── IDE / OS ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

